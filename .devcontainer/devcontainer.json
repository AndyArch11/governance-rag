// For format details, see https://aka.ms/devcontainer.json
{
	"name": "governance-rag (Python 3.13)",
	"image": "mcr.microsoft.com/devcontainers/python:2-3.13-trixie",
	"workspaceFolder": "/workspaces/governance-rag",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/governance-rag,type=bind",

	// Named volumes keep the container venv separate from the host .venv and persist pip/HF/Docling caches
	"mounts": [
		"source=governance-rag-venv,target=/workspaces/governance-rag/.venv,type=volume",
		"source=governance-rag-cache,target=/home/vscode/.cache,type=volume"
	],

	// Ollama runs on the WSL host; it must listen on 0.0.0.0 (OLLAMA_HOST=0.0.0.0 ollama serve)
	"runArgs": [
		"--add-host=host.docker.internal:host-gateway",
		"--shm-size=2g"
	],
	"hostRequirements": {
		"gpu": "optional"
	},
	"containerEnv": {
		"OLLAMA_HOST": "${localEnv:DEVCONTAINER_OLLAMA_HOST:http://host.docker.internal:11434}",
		"DASHBOARD_HOST": "0.0.0.0",
		"PYTHONUNBUFFERED": "1"
	},

	"forwardPorts": [8050, 8051],
	"portsAttributes": {
		"8050": {"label": "Dashboard", "onAutoForward": "notify"},
		"8051": {"label": "Dashboard alternate", "onAutoForward": "notify"}
	},

	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"postStartCommand": "curl -sf --max-time 5 \"$OLLAMA_HOST/api/tags\" > /dev/null && echo \"Ollama reachable at $OLLAMA_HOST\" || echo \"WARNING: Ollama not reachable at $OLLAMA_HOST\"",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.black-formatter",
				"ms-python.isort",
				"ms-python.pylint",
				"ms-python.mypy-type-checker",
				"ms-toolsai.jupyter",
				"GitHub.copilot-chat"
			],
			"settings": {
				"python.defaultInterpreterPath": "/workspaces/governance-rag/.venv/bin/python",
				"python.terminal.activateEnvironment": true,
				"python.testing.pytestEnabled": true,
				"python.testing.unittestEnabled": false,
				"python.testing.pytestArgs": ["tests"]
			}
		}
	},

	"remoteUser": "vscode"
}
